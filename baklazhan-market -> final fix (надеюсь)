  sdelatStrany();
  pokazatTovary();
  pokazatKorzinu();
}


// =====================================================
//  ТУМБЛЕР НА ТРИ ПОЛОЖЕНИЯ
//  кружок можно тянуть или просто нажать на секцию;
//  когда отпускаем — он прыгает в ближайшую секцию
// =====================================================

var RAZMER_KRUZHKA = 34;

// x-координата центра секции n (0, 1 или 2)
function centrSekcii(n) {
  return (n + 0.5) * $("tumbler").offsetWidth / 3;
}

// в какой секции находится точка x
function blizhaishayaSekciya(x) {
  var n = Math.floor(x / ($("tumbler").offsetWidth / 3));
  if (n < 0) n = 0;
  if (n > 2) n = 2;
  return n;
}

// сдвинуть кружок в точку x
function dvigatKruzhok(x) {
  $("tumbler-tochka").style.transform = "translateX(" + (x - RAZMER_KRUZHKA / 2) + "px)";
}

// поставить кружок в секцию n и подписать режим
function postavitKruzhok(n) {
  dvigatKruzhok(centrSekcii(n));
  $("tumbler").setAttribute("aria-valuenow", n);
  $("tumbler").setAttribute("aria-valuetext", NAZVANIE_REZHIMA[n]);
  $("rezhim-slovo").innerHTML = NAZVANIE_REZHIMA[n];
}

// выбрали секцию n
function vybratSekciyu(n) {
  var novyi = REZHIMY[n];
  if (novyi == rezhim) {
    postavitKruzhok(n);
    return;
  }
  // в 21+ пускаем только после проверки возраста
  if (novyi == "21" && !vozrastProveren) {
    postavitKruzhok(REZHIMY.indexOf(rezhim)); // кружок назад
    otkrytOknoVozrasta();
    return;
  }
  pereklyuchitRezhim(novyi);
}

// вешаем на тумблер мышь, палец и клавиатуру
function nastroitTumbler() {
  var tumbler = $("tumbler");
  var tyanem = false;
  var startX = 0;

  // x внутри тумблера, не дальше центров крайних секций
  function xVnutri(e) {
    var x = e.clientX - tumbler.getBoundingClientRect().left;
    if (x < centrSekcii(0)) x = centrSekcii(0);
    if (x > centrSekcii(2)) x = centrSekcii(2);
    return x;
  }

  // нажали
  tumbler.addEventListener("pointerdown", function (e) {
    tyanem = true;
    startX = e.clientX;
    tumbler.setPointerCapture(e.pointerId);
    tumbler.classList.add("tyanem");
  });

  // тянем
  tumbler.addEventListener("pointermove", function (e) {
    if (!tyanem) return;
    if (Math.abs(e.clientX - startX) < 3) return; // сдвиг меньше 3px — это просто клик
    dvigatKruzhok(xVnutri(e));
  });

  // отпустили
  tumbler.addEventListener("pointerup", function (e) {
    if (!tyanem) return;
    tyanem = false;
    tumbler.classList.remove("tyanem");
    vybratSekciyu(blizhaishayaSekciya(xVnutri(e)));
  });

  // жест прервался (например, пришёл звонок)
  tumbler.addEventListener("pointercancel", function () {
    tyanem = false;
    tumbler.classList.remove("tyanem");
    postavitKruzhok(REZHIMY.indexOf(rezhim));
  });

  // стрелки влево/вправо на клавиатуре
  tumbler.addEventListener("keydown", function (e) {
    var n = REZHIMY.indexOf(rezhim);
    if (e.key == "ArrowRight" && n < 2) { vybratSekciyu(n + 1); e.preventDefault(); }
    if (e.key == "ArrowLeft" && n > 0) { vybratSekciyu(n - 1); e.preventDefault(); }
  });
}


