<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Баклажан Маркет</title>
<style>
/* шрифты: Baloo 2 для заголовков и цен, Manrope для всего остального */
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');

/* ===== ЦВЕТА =====
   все цвета сайта в одном месте, дальше они используются как var(--имя) */
:root {
  --fiolet: #8b2fff;                       /* главный фиолетовый */
  --fiolet-temny: #5b12c4;                 /* тёмный фиолетовый (градиенты, наведение) */
  --fiolet-tekst: #7c3aed;                 /* фиолетовый для текста */
  --fiolet-svetly: rgba(139,47,255,.11);   /* бледный фиолетовый фон */
  --fon: #f4f4f7;                          /* фон страницы */
  --fon-kartochki: #ffffff;                /* фон карточек и блоков */
  --fon-2: #ececf1;                        /* дорожка ползунка */
  --tekst: #1d1d1f;                        /* основной текст */
  --seryi: #6e6e76;                        /* второстепенный текст */
  --liniya: #e4e4ea;                       /* рамки */
  --ten: 0 10px 30px rgba(50,20,100,.10);  /* тень при наведении */
  --navedenie: #f1e8ff;                    /* фон кнопки корзины при наведении */
}

/* ===== ОБЩЕЕ ===== */
* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--fon);
  color: var(--tekst);
  font-family: 'Manrope', Arial, sans-serif;
  font-size: 14px;
  min-height: 100vh;
  display: flex;            /* чтобы подвал всегда был внизу */
  flex-direction: column;
}

/* сбрасываем стандартный вид кнопок и ссылок */
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
a { color: inherit; }

/* ===== ШАПКА (фиолетовая полоса сверху, прилипает при прокрутке) ===== */
.shapka {
  position: sticky;
  top: 0;
  z-index: 40;
  background: linear-gradient(90deg, var(--fiolet-temny), var(--fiolet));
  color: white;
  box-shadow: 0 4px 20px rgba(60,10,140,.25);
}
.shapka-ryad {
  max-width: 1240px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  gap: 18px;
}

/* логотип: кружок с баклажаном + надпись */
.logo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Baloo 2', Arial, sans-serif;
  font-weight: 800;
  font-size: 26px;
  color: white;
  flex-shrink: 0;
}
.logo-znak {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  display: grid;
  place-items: center;
  font-size: 19px;
}
.logo em { color: #e2ccff; font-style: normal; }

/* строка поиска */
.poisk {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255,255,255,.16);
  border: 1.5px solid transparent;
  border-radius: 14px;
  padding: 0 16px;
  height: 46px;
}
.poisk:focus-within { border-color: rgba(255,255,255,.8); background: rgba(255,255,255,.24); }
.poisk input {
  border: none;
  outline: none;
  background: none;
  width: 100%;
  font-size: 15px;
  font-family: inherit;
  color: white;
}
.poisk input::placeholder { color: rgba(255,255,255,.72); }

/* правая часть шапки: тумблер, профиль, корзина */
.knopki { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.profil {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: rgba(255,255,255,.16);
  display: grid;
  place-items: center;
  color: white;
}
.profil:hover { background: rgba(255,255,255,.26); }

.korzina-knopka {
  display: flex;
  align-items: center;
  gap: 8px;
  background: white;
  color: var(--fiolet-temny);
  height: 46px;
  padding: 0 20px 0 16px;
  border-radius: 14px;
  font-weight: 800;
  font-size: 15px;
}
.korzina-knopka:hover { background: var(--navedenie); }

/* кружок с количеством товаров на кнопке корзины */
.schet {
  background: var(--fiolet);
  color: white;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 800;
  display: grid;
  place-items: center;
}

/* ===== ТУМБЛЕР РЕЖИМОВ (как на айфоне, но на 3 положения) ===== */
.rezhim-zona {
  display: flex;
  align-items: center;
  gap: 9px;
  background: rgba(0,0,0,.16);
  padding: 6px 12px;
  border-radius: 999px;
  flex-shrink: 0;
  user-select: none;
  -webkit-user-select: none;
}
/* название режима рядом с тумблером */
.rezhim-slovo {
  font-weight: 800;
  font-size: 13px;
  white-space: nowrap;
  min-width: 64px;
}

/* сама дорожка, поделена на 3 секции */
.tumbler {
  position: relative;
  display: flex;
  width: 114px;
  height: 34px;
  border-radius: 17px;
  background: rgba(255,255,255,.2);
  box-shadow: inset 0 1px 3px rgba(0,0,0,.25);
  cursor: pointer;
  flex-shrink: 0;
  touch-action: none; /* чтобы на телефоне страница не прокручивалась, пока тянем кружок */
  user-select: none;
  -webkit-user-select: none;
}
.tumbler:focus-visible { outline: 2px solid white; outline-offset: 3px; }

/* значки секций: 🥗 🍔 21 */
.tumbler-metka {
  flex: 1;
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 800;
  opacity: .6;
  pointer-events: none;
}

/* белый кружок, который ездит по дорожке */
.tumbler-tochka {
  position: absolute;
  top: 0;
  left: 0;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: white;
  border: 2.5px solid white;
  box-shadow: 0 3px 10px rgba(0,0,0,.35);
  pointer-events: none;
  transition: transform .32s cubic-bezier(.3,1.35,.5,1); /* пружинистый прыжок */
}
/* пока тянем пальцем — кружок без задержки */
.tumbler.tyanem .tumbler-tochka { transition: none; }

/* ===== ОСНОВНАЯ ЧАСТЬ ===== */
.konteiner { max-width: 1240px; margin: 0 auto; padding: 0 20px; width: 100%; }
.osnova { flex: 1; }

/* хлебные крошки: «Главная · ... · Каталог» */
.kroshki { padding: 18px 0 4px; font-size: 13px; color: var(--seryi); font-weight: 600; }
.kroshki b { color: var(--tekst); }

/* предупреждение про алкоголь (только в режиме 21+) */
.vnimanie {
  margin-top: 12px;
  background: #2a1206;
  border: 1px solid #5a2a0e;
  color: #ffb38a;
  border-radius: 12px;
  padding: 10px 14px;
  font-weight: 700;
  font-size: 13px;
}

/* ряд кнопок-категорий, прокручивается вбок */
.kategorii {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 14px 0 6px;
  scrollbar-width: none;
}
.kat-knopka {
  flex-shrink: 0;
  background: var(--fon-kartochki);
  border: 1.5px solid var(--liniya);
  padding: 9px 16px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 13.5px;
  color: var(--tekst);
  white-space: nowrap;
}
.kat-knopka:hover { border-color: var(--fiolet); color: var(--fiolet-tekst); }
.kat-knopka.vazhno { border-color: var(--fiolet); }                                  /* выделенная категория */
.kat-knopka.aktiv { background: var(--fiolet); border-color: var(--fiolet); color: white; } /* выбранная сейчас */

/* две колонки: фильтры слева, товары справа */
.setka {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 26px;
  padding: 18px 0 60px;
}

/* ===== ФИЛЬТРЫ (левая колонка) ===== */
.kolonka { display: flex; flex-direction: column; gap: 14px; }
.filtr {
  background: var(--fon-kartochki);
  border-radius: 18px;
  padding: 18px;
  border: 1px solid var(--liniya);
}
.filtr h3 { font-family: 'Baloo 2', Arial, sans-serif; margin: 0 0 14px; font-size: 17px; }

/* мин и макс цена над ползунком */
.ceny { display: flex; justify-content: space-between; margin-bottom: 12px; }
.ceny span {
  background: var(--fiolet-svetly);
  color: var(--fiolet-tekst);
  font-weight: 800;
  font-size: 13px;
  padding: 5px 11px;
  border-radius: 8px;
}

/* ползунок цены */
input[type=range] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 4px;
  background: var(--fon-2);
  outline: none;
}
/* кружок ползунка (для Chrome/Safari и для Firefox) */
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--fiolet);
  border: 3px solid white;
  cursor: pointer;
}
input[type=range]::-moz-range-thumb {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--fiolet);
  border: 3px solid white;
  cursor: pointer;
}

/* галочки: настоящий checkbox спрятан, рисуем свой квадратик */
.galka {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  color: var(--tekst);
}
.galka input { display: none; }
.kvadrat {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  border: 2px solid var(--liniya);
  flex-shrink: 0;
  display: grid;
  place-items: center;
  color: white;
  font-size: 12px;
  font-weight: 900;
}
.kvadrat::after { content: "✓"; opacity: 0; }
.galka input:checked + .kvadrat { background: var(--fiolet); border-color: var(--fiolet); }
.galka input:checked + .kvadrat::after { opacity: 1; }

/* ===== КАТАЛОГ (правая колонка) ===== */
/* заголовок + сортировка */
.verh-kataloga {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  gap: 12px;
  flex-wrap: wrap;
}
.verh-kataloga h1 { font-family: 'Baloo 2', Arial, sans-serif; margin: 0; font-size: 30px; }
.opisanie { color: var(--seryi); font-weight: 600; margin: 0 0 16px; }
.sortirovka {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--fon-kartochki);
  border: 1px solid var(--liniya);
  border-radius: 12px;
  padding: 0 14px;
  height: 42px;
  font-weight: 700;
  font-size: 13.5px;
}
.sortirovka select {
  border: none;
  background: none;
  font-family: inherit;
  font-weight: 700;
  font-size: 13.5px;
  outline: none;
  cursor: pointer;
  color: var(--tekst);
}
.sortirovka option { background: var(--fon-kartochki); color: var(--tekst); }

/* раздел каталога: заголовок, счётчик, «Смотреть все», товары */
.razdel { margin-bottom: 34px; }
.razdel-shapka { display: flex; align-items: baseline; gap: 10px; margin: 6px 0 4px; flex-wrap: wrap; }
.razdel-shapka h2 { font-family: 'Baloo 2', Arial, sans-serif; font-size: 23px; margin: 0; }
.razdel-chislo {
  background: var(--fiolet-svetly);
  color: var(--fiolet-tekst);
  font-weight: 800;
  font-size: 12px;
  padding: 3px 9px;
  border-radius: 999px;
}
.smotret { margin-left: auto; color: var(--fiolet-tekst); font-weight: 800; font-size: 13px; }
.razdel-tekst { color: var(--seryi); font-weight: 600; font-size: 13px; margin: 0 0 12px; }

/* особый раздел в рамке (салаты, десерты, закуски) */
.razdel.osobyi {
  background: var(--fon-kartochki);
  border: 1.5px solid var(--fiolet-svetly);
  border-radius: 22px;
  padding: 18px;
}
.razdel.osobyi .kartochka { background: var(--fon); }

/* сетка карточек: столько колонок, сколько влезет */
.tovary {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}

/* ===== КАРТОЧКА ТОВАРА ===== */
.kartochka {
  background: var(--fon-kartochki);
  border-radius: 18px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform .14s, box-shadow .14s;
}
.kartochka:hover { transform: translateY(-3px); box-shadow: var(--ten); }

/* квадрат с эмодзи товара */
.kartinka {
  aspect-ratio: 1;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-size: 76px;
  margin-bottom: 12px;
}

/* значок скидки слева сверху */
.skidka {
  position: absolute;
  top: 20px;
  left: 20px;
  background: #ff5a3c;
  color: white;
  font-weight: 800;
  font-size: 12px;
  padding: 4px 9px;
  border-radius: 8px;
}
/* значок 21+ справа сверху */
.metka-21 {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(0,0,0,.55);
  color: white;
  border: 1px solid rgba(255,255,255,.25);
  font-weight: 800;
  font-size: 11px;
  padding: 3px 7px;
  border-radius: 7px;
}

/* название и строка «★ рейтинг · страна · объём» */
.nazvanie { font-weight: 700; font-size: 14.5px; line-height: 1.3; margin-bottom: 8px; min-height: 38px; }
.info { font-size: 12.5px; color: var(--seryi); font-weight: 600; margin-bottom: 14px; }
.info .zvezda { color: #ffb020; }
.info b { color: var(--tekst); }

/* низ карточки: цена слева, кнопка справа */
.niz { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cena { font-family: 'Baloo 2', Arial, sans-serif; font-weight: 800; font-size: 20px; line-height: 1; }
.stara-cena { font-size: 12px; color: var(--seryi); text-decoration: line-through; font-weight: 600; margin-top: 3px; }

/* кнопка «+» (товара ещё нет в корзине) */
.dobavit {
  width: 44px;
  height: 44px;
  border-radius: 13px;
  background: var(--fiolet-svetly);
  color: var(--fiolet-tekst);
  font-size: 26px;
  font-weight: 600;
  flex-shrink: 0;
}
.dobavit:hover { background: var(--fiolet); color: white; }

/* счётчик «− 2 +» (товар уже в корзине) */
.schet-knopki {
  display: flex;
  align-items: center;
  background: var(--fiolet);
  border-radius: 13px;
  height: 44px;
  color: white;
  font-weight: 800;
  overflow: hidden;
}
.schet-knopki button { width: 38px; height: 44px; color: white; font-size: 20px; }
.schet-knopki button:hover { background: var(--fiolet-temny); }
.schet-knopki span { min-width: 30px; text-align: center; font-size: 15px; }

/* ===== КАРТОЧКА В РЕЖИМЕ 21+ =====
   светлая с винным оттенком и тонкой красной полоской снизу */
.kartochka.kartochka-21,
.razdel.osobyi .kartochka.kartochka-21 {
  background: linear-gradient(180deg, #ffffff 0%, #fff4f6 100%);
  border: 1px solid #f6d5dc;
  box-shadow: inset 0 -3px 0 #e5243b; /* красная полоска снизу */
  overflow: hidden;
}
.kartochka.kartochka-21:hover {
  border-color: #eeb3c0;
  box-shadow: inset 0 -3px 0 #e5243b, 0 12px 28px rgba(155,27,58,.14);
}
/* !important — потому что у картинки фон задан прямо в теге (style="background:...") */
.kartochka-21 .kartinka {
  background: radial-gradient(circle at 50% 40%, #ffffff 0%, #fbe8ec 75%) !important;
  border: 1px solid #f6d5dc;
}
.kartochka-21 .info b { color: #9b1b3a; }
.kartochka-21 .cena { color: #9b1b3a; }
.kartochka-21 .metka-21 { background: #e5243b; border-color: transparent; }
.kartochka-21 .dobavit { background: #fbe3e8; color: #c41e3a; }
.kartochka-21 .dobavit:hover { background: #c41e3a; color: #ffffff; }
.kartochka-21 .schet-knopki { background: #c41e3a; }
.kartochka-21 .schet-knopki button:hover { background: #9b1b3a; }

/* «Ничего не найдено» */
.nichego { text-align: center; padding: 70px 20px; color: var(--seryi); font-weight: 600; }
.nichego div { font-size: 54px; margin-bottom: 10px; }

/* ===== ПОДВАЛ (низ сайта) ===== */
.podval {
  background: linear-gradient(90deg, var(--fiolet-temny), var(--fiolet));
  color: white;
}
/* 4 колонки: логотип, покупателям, компания, контакты */
.podval-shapka {
  max-width: 1240px;
  margin: 0 auto;
  padding: 36px 20px 20px;
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1fr;
  gap: 28px;
}
.podval-shapka p { margin: 10px 0 0; opacity: .82; font-weight: 600; line-height: 1.5; max-width: 320px; }
.podval h4 { margin: 4px 0 12px; font-family: 'Baloo 2', Arial, sans-serif; font-size: 17px; }
.podval a { display: block; text-decoration: none; opacity: .82; font-weight: 600; padding: 4px 0; }
.podval a:hover { opacity: 1; text-decoration: underline; }
/* самая нижняя строка: © и слоган */
.podval-nizu {
  max-width: 1240px;
  margin: 0 auto;
  padding: 16px 20px 22px;
  border-top: 1px solid rgba(255,255,255,.2);
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 12.5px;
  font-weight: 600;
}

/* ===== КОРЗИНА (выезжает справа) ===== */
/* затемнение страницы за корзиной */
.fon-temnyi {
  position: fixed;
  inset: 0;
  background: rgba(10,6,20,.5);
  display: none;
  z-index: 50;
}
/* сама панель: спрятана за правым краем, класс .otkryta выдвигает её */
.korzina {
  position: fixed;
  top: 0;
  right: -430px;
  height: 100%;
  width: 420px;
  max-width: 100%;
  background: var(--fon);
  z-index: 60;
  transition: right .28s;
  display: flex;
  flex-direction: column;
}
.korzina.otkryta { right: 0; }
.korzina-shapka {
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, var(--fiolet-temny), var(--fiolet));
  color: white;
}
.korzina-shapka h2 { font-family: 'Baloo 2', Arial, sans-serif; margin: 0; font-size: 22px; }
.zakryt {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: rgba(255,255,255,.18);
  color: white;
  font-size: 18px;
}

/* список товаров в корзине */
.korzina-tovary { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
.stroka-korziny {
  background: var(--fon-kartochki);
  border-radius: 14px;
  padding: 12px;
  display: flex;
  gap: 12px;
  align-items: center;
}
.mini-kartinka {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  font-size: 34px;
}
.stroka-korziny .tekst { flex: 1; min-width: 0; font-weight: 700; font-size: 13.5px; }
.stroka-korziny .tekst small { display: block; color: var(--seryi); font-weight: 600; font-size: 12.5px; margin-top: 2px; }
.mini-knopki { display: flex; align-items: center; gap: 4px; font-weight: 800; font-size: 13px; }
.mini-knopki button {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--fon);
  font-size: 16px;
  font-weight: 800;
  color: var(--fiolet-tekst);
}
.stroka-summa { font-family: 'Baloo 2', Arial, sans-serif; font-weight: 800; font-size: 15px; min-width: 62px; text-align: right; }

/* «Корзина пуста» */
.pusto { text-align: center; color: var(--seryi); padding: 70px 20px; font-weight: 600; }
.pusto div { font-size: 60px; margin-bottom: 12px; }

/* итог внизу корзины: суммы и кнопка «Оформить» */
.korzina-itog {
  background: var(--fon-kartochki);
  border-top: 1px solid var(--liniya);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.stroka { display: flex; justify-content: space-between; align-items: baseline; color: var(--seryi); font-weight: 600; }
.stroka span:last-child { color: var(--tekst); }
.stroka.itogo { color: var(--tekst); font-weight: 800; font-size: 16px; }
.stroka.itogo span:last-child { font-family: 'Baloo 2', Arial, sans-serif; font-size: 24px; }

/* большая фиолетовая кнопка */
.glav-knopka {
  background: var(--fiolet);
  color: white;
  height: 54px;
  border-radius: 15px;
  font-weight: 800;
  font-size: 16px;
  width: 100%;
}
.glav-knopka:hover { background: var(--fiolet-temny); }
.glav-knopka:disabled { opacity: .4; cursor: not-allowed; }
.dostavka-stroka { font-size: 12px; color: var(--fiolet-tekst); font-weight: 700; text-align: center; }
.pasport-stroka { font-size: 12px; color: #ff9f6b; font-weight: 700; text-align: center; }

/* ===== ОКНО ПРОВЕРКИ ВОЗРАСТА ===== */
/* тёмный размытый фон на весь экран */
.fon-okna {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(0,0,0,.72);
  backdrop-filter: blur(6px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
/* само окошко */
.okno {
  width: 420px;
  max-width: 100%;
  background: #111113;
  color: #f2f2f4;
  border: 1px solid #2a2a2f;
  border-radius: 24px;
  padding: 28px 24px 22px;
  text-align: center;
}
/* винный круг «21+» */
.znak-21 {
  width: 74px;
  height: 74px;
  margin: 0 auto 14px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #4a0816, #9b1b3a);
  font-family: 'Baloo 2', Arial, sans-serif;
  font-weight: 800;
  font-size: 26px;
}
.okno h2 { font-family: 'Baloo 2', Arial, sans-serif; margin: 0 0 6px; font-size: 25px; }
.okno p { margin: 0 0 18px; color: #a1a1a8; font-weight: 600; line-height: 1.45; }
.okno label { display: block; text-align: left; font-weight: 800; font-size: 12.5px; color: #a1a1a8; margin-bottom: 8px; }
/* три выпадающих списка: день, месяц, год */
.blok-daty { display: grid; grid-template-columns: 1fr 1.6fr 1.2fr; gap: 8px; margin-bottom: 12px; }
.blok-daty select {
  height: 46px;
  border-radius: 12px;
  border: 1.5px solid #2a2a2f;
  background: #1c1c1f;
  color: #f2f2f4;
  font-family: inherit;
  font-weight: 700;
  font-size: 14px;
  padding: 0 10px;
}
.okno .glav-knopka { background: #9b1b3a; }
.okno .glav-knopka:hover { background: #6e0f26; }
.oshibka { min-height: 20px; color: #ff6b5a; font-weight: 700; font-size: 13px; margin-bottom: 10px; }
.otmena { margin-top: 8px; width: 100%; height: 46px; border-radius: 14px; color: #c9c9cf; font-weight: 700; font-size: 14px; }
.otmena:hover { background: #1c1c1f; }
.snoska { margin-top: 12px; font-size: 11.5px; color: #6e6e76; font-weight: 600; }

/* ===== ВСПЛЫВАШКА ВНИЗУ («Добавлено в корзину») ===== */
.podskazka {
  position: fixed;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  background: var(--tekst);
  color: var(--fon);
  padding: 13px 22px;
  border-radius: 14px;
  font-weight: 700;
  font-size: 14px;
  z-index: 95;
  display: none;
}

/* ===== ПОД ТЕЛЕФОНЫ И ПЛАНШЕТЫ ===== */
/* узкий экран: прячем название режима у тумблера */
@media (max-width: 980px) {
  .rezhim-slovo { display: none; }
}
/* планшет: фильтры прячем, подвал в 2 колонки */
@media (max-width: 860px) {
  .setka { grid-template-columns: 1fr; }
  .kolonka { display: none; }
  .podval-shapka { grid-template-columns: 1fr 1fr; }
}
/* телефон: поиск на отдельной строке, товары по 2 в ряд */
@media (max-width: 620px) {
  .shapka-ryad { flex-wrap: wrap; gap: 12px; padding: 12px 16px; }
  .poisk { order: 3; flex-basis: 100%; }
  .logo { font-size: 22px; }
  .konteiner { padding: 0 16px; }
  .korzina-knopka .slovo { display: none; }
  .korzina-knopka { padding: 0 14px; }
  .profil { display: none; }
  .knopki { margin-left: auto; }
  .tovary { grid-template-columns: 1fr 1fr; gap: 10px; }
  .kartinka { font-size: 56px; }
  .razdel.osobyi { padding: 12px; }
}
