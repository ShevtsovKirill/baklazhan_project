  html += '<div class="kartinka" style="background:' + tovar.fon + '">' + tovar.kartinka + '</div>';
  html += '<div class="nazvanie">' + tovar.nazvanie + '</div>';
  html += '<div class="info"><span class="zvezda">★</span> <b>' + tovar.reiting.toFixed(1) + '</b> · ' + tovar.strana + ' · ' + tovar.edinica + '</div>';

  // низ: цена (и старая цена, если есть скидка)
  html += '<div class="niz"><div>';
  html += '<div class="cena">' + krasivayaCena(tovar.cena) + '</div>';
  if (tovar.staraya_cena) {
    html += '<div class="stara-cena">' + krasivayaCena(tovar.staraya_cena) + '</div>';
  }
  html += '</div>';

  // уже в корзине — счётчик «− 2 +», иначе кнопка «+»
  if (korzina[tovar.id]) {
    html += '<div class="schet-knopki"><button onclick="minus(' + tovar.id + ')">−</button><span>' + korzina[tovar.id] + '</span><button onclick="plus(' + tovar.id + ')">+</button></div>';
  } else {
    html += '<button class="dobavit" onclick="dobavitVKorzinu(' + tovar.id + ')">+</button>';
  }

  html += '</div></div>';
  return html;
}

// сортировка по выбору в списке «Сортировка»
function otsortirovat(spisok) {
  if (sortirovka == "deshevle") spisok.sort(function (a, b) { return a.cena - b.cena; });
  if (sortirovka == "dorozhe") spisok.sort(function (a, b) { return b.cena - a.cena; });
  if (sortirovka == "reiting") spisok.sort(function (a, b) { return b.reiting - a.reiting; });
  return spisok;
}

// HTML сетки из карточек
function sdelatSetku(spisok) {
  var html = '<div class="tovary">';
  for (var i = 0; i < spisok.length; i++) {
    html += sdelatKartochku(spisok[i]);
  }
  return html + '</div>';
}

// главная функция: фильтрует товары и выводит их на страницу
function pokazatTovary() {
  var tovary = tovaryRezhima();
  var kategorii = kategoriiRezhima();

  // 1. заголовок и описание над каталогом
  if (vybranayaKategoriya == "vse") {
    $("zagolovok").innerHTML = TEKSTY[rezhim].zagolovok;
    $("opisanie").innerHTML = "";
  } else {
    for (var k = 0; k < kategorii.length; k++) {
      if (kategorii[k].id == vybranayaKategoriya) {
        $("zagolovok").innerHTML = kategorii[k].nazvanie;
        $("opisanie").innerHTML = kategorii[k].opisanie || "";
      }
    }
  }

  // 2. оставляем только товары, которые подходят под все фильтры
  var podhodyat = [];
  for (var i = 0; i < tovary.length; i++) {
    var t = tovary[i];
    if (vybranayaKategoriya != "vse" && t.kategoriya != vybranayaKategoriya) continue;
    if (tekstPoiska != "" && t.nazvanie.toLowerCase().indexOf(tekstPoiska) == -1) continue;
    if (t.cena > maxCena) continue;
    if (tolkoSkidka && !t.staraya_cena) continue;
    if (tolkoKz && !t.kz) continue;
    if (tolkoEko && !t.eko) continue;
    if (vybranayaStrana != "" && t.strana != vybranayaStrana) continue;
    podhodyat.push(t);
  }

  // 3а. ничего не нашлось
  if (podhodyat.length == 0) {
    $("katalog").innerHTML = '<div class="nichego"><div>' + TEKSTY[rezhim].nichego + '</div>Ничего не найдено. Попробуйте изменить фильтры.</div>';
    return;
  }

  // 3б. выбрана одна категория — просто сетка
  if (vybranayaKategoriya != "vse") {
    $("katalog").innerHTML = sdelatSetku(otsortirovat(podhodyat));
    return;
  }

  // 3в. «Все товары» — разбиваем по разделам-категориям
  var html = "";
  for (var n = 1; n < kategorii.length; n++) { // с 1, потому что 0 — это «Все товары»
    var kat = kategorii[n];
    var vRazdele = [];
    for (var m = 0; m < podhodyat.length; m++) {
      if (podhodyat[m].kategoriya == kat.id) vRazdele.push(podhodyat[m]);
    }
    if (vRazdele.length == 0) continue; // пустые разделы не показываем

    html += '<div class="razdel' + (kat.ramka ? ' osobyi' : '') + '">';
    html += '<div class="razdel-shapka"><h2>' + kat.nazvanie + '</h2><span class="razdel-chislo">' + vRazdele.length + '</span>';
    html += '<button class="smotret" onclick="vybratKategoriyu(\'' + kat.id + '\')">Смотреть все →</button></div>';
    if (kat.opisanie) {
      html += '<p class="razdel-tekst">' + kat.opisanie + '</p>';
    } else {
      html += '<div style="height:8px"></div>';
    }
    html += sdelatSetku(otsortirovat(vRazdele));
    html += '</div>';
  }
  $("katalog").innerHTML = html;
}


// =====================================================
//  КОРЗИНА
// =====================================================

// сохранить корзину и перерисовать карточки и корзину
function obnovitKorzinu() {
  localStorage.setItem("korzina", JSON.stringify(korzina));
  pokazatTovary();
  pokazatKorzinu();
}

function dobavitVKorzinu(id) {
  korzina[id] = (korzina[id] || 0) + 1; // если товара не было — станет 1
  obnovitKorzinu();
  pokazatSoobshenie(naitiTovar(id).kartinka + " Добавлено в корзину");
}

function plus(id) {
  korzina[id] = korzina[id] + 1;
  obnovitKorzinu();
}

function minus(id) {
  korzina[id] = korzina[id] - 1;
  if (korzina[id] <= 0) delete korzina[id]; // дошли до нуля — убираем товар
  obnovitKorzinu();
}

// сумма товаров в корзине
function summaKorziny() {
  var summa = 0;
  for (var id in korzina) {
    summa += naitiTovar(id).cena * korzina[id];
  }
  return summa;
}

// рисуем содержимое корзины и итог
function pokazatKorzinu() {
  var vsegoShtuk = 0;
  var estAlkogol = false;
  var html = "";

  for (var id in korzina) {
    var tovar = naitiTovar(id);
    var kolvo = korzina[id];
    vsegoShtuk += kolvo;
    if (nuzhen21(tovar.kategoriya)) estAlkogol = true;

    html += '<div class="stroka-korziny">';
    html += '<div class="mini-kartinka" style="background:' + tovar.fon + '">' + tovar.kartinka + '</div>';
    html += '<div class="tekst">' + tovar.nazvanie + '<small>' + krasivayaCena(tovar.cena) + ' / ' + tovar.edinica + '</small></div>';
    html += '<div class="mini-knopki"><button onclick="minus(' + id + ')">−</button><span>' + kolvo + '</span><button onclick="plus(' + id + ')">+</button></div>';
    html += '<div class="stroka-summa">' + krasivayaCena(tovar.cena * kolvo) + '</div>';
    html += '</div>';
  }

  // число на кнопке корзины в шапке
  $("schet").innerHTML = vsegoShtuk;

  // корзина пустая
  if (vsegoShtuk == 0) {
    $("spisok-korziny").innerHTML = '<div class="pusto">' + TEKSTY[rezhim].pusto + '</div>';
    $("itog-korziny").style.display = "none";
    return;
  }

  $("spisok-korziny").innerHTML = html;

  // доставка бесплатная от BESPLATNAYA_DOSTAVKA
  var summa = summaKorziny();
  var dostavka = (summa >= BESPLATNAYA_DOSTAVKA) ? 0 : CENA_DOSTAVKI;

  $("summa-tovarov").innerHTML = krasivayaCena(summa);
  if (dostavka == 0) {
    $("summa-dostavki").innerHTML = "Бесплатно";
    $("dostavka-fraza").innerHTML = "🎉 Доставка бесплатно!";
  } else {
    $("summa-dostavki").innerHTML = krasivayaCena(dostavka);
    $("dostavka-fraza").innerHTML = "Добавьте ещё на " + krasivayaCena(BESPLATNAYA_DOSTAVKA - summa) + " для бесплатной доставки";
  }
  $("itogo").innerHTML = krasivayaCena(summa + dostavka);

  // напоминание про документ, если в корзине алкоголь или табак
  $("pasport-fraza").style.display = estAlkogol ? "block" : "none";
  $("itog-korziny").style.display = "flex";
}

function otkrytKorzinu() {
  $("korzina").classList.add("otkryta");
  $("fon-temnyi").style.display = "block";
}

function zakrytKorzinu() {
  $("korzina").classList.remove("otkryta");
  $("fon-temnyi").style.display = "none";
}

function oformitZakaz() {
  var summa = summaKorziny();
  if (summa < BESPLATNAYA_DOSTAVKA) summa += CENA_DOSTAVKI;
  pokazatSoobshenie("✅ Заказ оформлен на " + krasivayaCena(summa));
  korzina = {};
  obnovitKorzinu();
  setTimeout(zakrytKorzinu, 700);
}


// =====================================================
//  ПРОВЕРКА ВОЗРАСТА
// =====================================================

// заполняем списки дней, месяцев и лет (100 лет назад от текущего)
function zapolnitDatu() {
  var mesyacy = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"];

  var dni = '<option value="">День</option>';
  for (var i = 1; i <= 31; i++) {
    dni += '<option value="' + i + '">' + i + '</option>';
  }
  $("den").innerHTML = dni;

  var mes = '<option value="">Месяц</option>';
  for (var j = 0; j < 12; j++) {
    mes += '<option value="' + (j + 1) + '">' + mesyacy[j] + '</option>';
  }
  $("mesyac").innerHTML = mes;

  var seichasGod = new Date().getFullYear();
  var goda = '<option value="">Год</option>';
  for (var g = seichasGod; g > seichasGod - 100; g--) {
    goda += '<option value="' + g + '">' + g + '</option>';
  }
  $("god").innerHTML = goda;
}

// открыть окно с чистыми полями
function otkrytOknoVozrasta() {
  $("den").value = "";
  $("mesyac").value = "";
  $("god").value = "";
  $("oshibka").innerHTML = "";
  $("knopka-ok").disabled = false;
  $("okno-21").style.display = "flex";
}

// нажали «Мне есть 21 — войти»
function proveritVozrast() {
  var den = Number($("den").value);
  var mesyac = Number($("mesyac").value);
  var god = Number($("god").value);

  // заполнено не всё
  if (den == 0 || mesyac == 0 || god == 0) {
    $("oshibka").innerHTML = "Укажите полную дату рождения";
    return;
  }

  // такой даты нет (например, 31 февраля — JS превратит её в 3 марта)
  var data = new Date(god, mesyac - 1, den);
  if (data.getMonth() != mesyac - 1) {
    $("oshibka").innerHTML = "Такой даты не существует";
    return;
  }

  // считаем полных лет: если день рождения в этом году ещё не наступил — минус год
  var segodnya = new Date();
  var vozrast = segodnya.getFullYear() - god;
  var mesyacSeichas = segodnya.getMonth() + 1;
  if (mesyacSeichas < mesyac || (mesyacSeichas == mesyac && segodnya.getDate() < den)) {
    vozrast = vozrast - 1;
  }

  // слишком молод — блокируем кнопку
  if (vozrast < MIN_VOZRAST) {
    $("oshibka").innerHTML = "Доступ запрещён: вам ещё нет " + MIN_VOZRAST + " года.";
    $("knopka-ok").disabled = true;
    return;
  }

  // всё хорошо — запоминаем и пускаем в 21+
  vozrastProveren = true;
  localStorage.setItem("vozrastProveren", "da");
  $("okno-21").style.display = "none";
  pereklyuchitRezhim("21");
  pokazatSoobshenie("🔓 Возраст подтверждён. Добро пожаловать!");
}

// нажали «Вернуться назад»
function otmenaVozrast() {
  $("okno-21").style.display = "none";
  postavitKruzhok(REZHIMY.indexOf(rezhim));
}


// =====================================================
//  ВСПЛЫВАЮЩЕЕ СООБЩЕНИЕ (исчезает через 1.8 секунды)
// =====================================================
var taimer;
function pokazatSoobshenie(tekst) {
  var s = $("podskazka");
  s.innerHTML = tekst;
  s.style.display = "block";
  clearTimeout(taimer);
  taimer = setTimeout(function () {
    s.style.display = "none";
  }, 1800);
}

// Esc закрывает окно возраста или корзину
document.onkeydown = function (e) {
  if (e.key != "Escape") return;
  if ($("okno-21").style.display == "flex") {
    otmenaVozrast();
  } else {
    zakrytKorzinu();
  }
};


// =====================================================
//  ЗАПУСК СТРАНИЦЫ
// =====================================================

// достаём из памяти браузера корзину и проверку возраста
if (localStorage.getItem("korzina")) {
  korzina = JSON.parse(localStorage.getItem("korzina"));
}
if (localStorage.getItem("vozrastProveren") == "da") {
  vozrastProveren = true;
}

zapolnitDatu();
nastroitTumbler();

// открываем режим, который был в прошлый раз (21+ — только если возраст уже проверен)
var sohranennyiRezhim = localStorage.getItem("rezhim");
if (sohranennyiRezhim == "21" && vozrastProveren) {
  pereklyuchitRezhim("21");
} else if (sohranennyiRezhim == "vrednoe") {
  pereklyuchitRezhim("vrednoe");
} else {
  pereklyuchitRezhim("poleznoe");
}
</script>

